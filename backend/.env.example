# Cosmos DB (Core/SQL API) — required by the running app.
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=your-database-name

# Signs/verifies auth JWTs — required by the running app, no default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never share this value with the frontend or any REACT_APP_* variable.
JWT_SECRET=generate-a-long-random-value

# Optional: comma-separated frontend origins allowed to call this API.
# Defaults to the known dev + prod origins if unset (see main.py).
# ALLOWED_ORIGINS=https://your-frontend-host.example.com
